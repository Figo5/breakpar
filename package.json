{
  "name": "break-par",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "./scripts/setup.sh",
    "db:reset": "./scripts/db-reset.sh",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "career:freeze": "tsx scripts/career-formula-freeze.ts",
    "career:backfill-bot-rounds": "tsx scripts/career-backfill-bot-rounds.ts",
    "career:simulate": "tsx scripts/career-simulate.ts",
    "career:simulate:player-paced": "tsx scripts/career-player-paced-simulate.ts",
    "engine:calibrate": "tsx scripts/calibrate.ts",
    "engine:audit": "tsx scripts/scoring-audit.ts",
    "test": "vitest run",
    "test:career-db": "vitest run --config vitest.career-db.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@prisma/client": "^5.20.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.0.0",
    "posthog-js": "^1.396.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
